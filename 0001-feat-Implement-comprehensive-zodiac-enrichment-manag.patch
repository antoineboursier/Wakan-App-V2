+
+        setSaving(false);
+
+        if (error) {
+            showToast("Erreur lors de la sauvegarde : " + error.message, "error");
+        } else {
+            showToast("Modifications enregistrées avec succès", "success");
+            router.refresh();
+        }
+    };
+
+    const handleReset = () => {
