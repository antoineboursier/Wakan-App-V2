+    const [description, setDescription] = useState(ruler?.description || '');
+    const [iconImageUrl, setIconImageUrl] = useState(ruler?.icon_image_url || '');
+
+    const handleSave = () => {
+        onUpdate(signSlug, planetSlug, description, iconImageUrl);
+    };
+
+    return (
